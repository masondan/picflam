/
  Cache-Control: no-cache, must-revalidate

/service-worker.js
  Cache-Control: no-cache, must-revalidate

/flam-nav.js
  Cache-Control: no-cache, must-revalidate

/manifest.json
  Cache-Control: no-cache, must-revalidate

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: no-cache, must-revalidate

/logos/*
  Cache-Control: no-cache, must-revalidate

/icons/*
  Cache-Control: no-cache, must-revalidate

/template-previews/*
  Cache-Control: no-cache, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
